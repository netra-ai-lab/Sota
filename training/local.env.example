# Copy to local.env and point these at your data (unset variables default to folders inside training/).
# SOTA_MODELS_DIR=/data/models/omniasr       # omniASR-CTC-1B/, omniASR-CTC-300M/, omniASR_tokenizer.model
# ASR_ROOT=/data/khmer                       # DDD + FLEURS-km shards and manifests (layout: docs/TRAINING.md)
# LIBRI_DIR=/data/librispeech                # LibriSpeech/<subset>/ is downloaded here
# FLEURS_EN_DIR=/data/fleurs-en              # FLEURS en_us wavs are written here
# SOTA_CACHE=/data/sota-cache                # decoded eval audio
